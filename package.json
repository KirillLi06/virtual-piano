{
  "name": "virtual-piano",
  "version": "1.0.0",
  "description": "Virtual Piano",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "start": "tsc && electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "prettier": "npx prettier src --write",
    "eslint": "npx eslint",
    "build:exe": "tsc && electron-builder"
  },
  "build": {
    "appId": "com.kirillli.virtualpiano",
    "productName": "Virtual Piano",
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ]
  },
  "author": "Kirill Li",
  "license": "MIT",
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "prettier": "^3.10.1"
  }
}
